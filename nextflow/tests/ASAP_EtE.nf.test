//nf-test test ./tests/ASAP_EtE.nf.test --silent --profile slurm --update-snapshot
//nf-test test ./tests/ASAP_EtE.nf.test --silent --profile slurm --updateSnapshot --wipeSnapshot

nextflow_pipeline {

    name "Test E2E ASAP Pipeline"
    script "main.nf"

    test ("Nextflow Help Test") {
        // Goal of this test is to ensure that the help documentation is functional.
        when {
            params {
                help = true
            }
        }
        then {
            assert workflow.success
            def targetFile = new File("tests/test_output/Help/help_docs.txt")
            targetFile.parentFile.mkdirs()
            targetFile.text = workflow.stdout
            
            assert snapshot(workflow.stdout).match("Help")
        }
    }

    test ("RSV E2E Multiple GB Input") {
        // Goal is to test simple ASAP functionality using RSV amplicon reads.
        // Paired end, 2 GB files, no asaptools testing.
        when {
            params {
                read_dir             = "${baseDir}/tests/data/RSV/"
                reference_input      = "${baseDir}/tests/preparejson/RSV*.gb"
                outdir               = "${baseDir}/tests/test_output/RSV_End_To_End_Test"
                aligner              = "bwa"
                proportion           = 0.1
                file_name            = "RSV_End_To_End_Test"
                asaptools_processing = false
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.stdout).match("RSV_End_To_End_Test_Out")
            
            // Check the combined XML
            def xmlReport = path("${baseDir}/tests/test_output/RSV_End_To_End_Test/RSV_End_To_End_Test_analysis.xml")
            assert xmlReport.exists()
            assert snapshot(xmlReport).match("combined_xml")
            
            // Check the combined HTML (Final Output)
            def htmlReport = path("${baseDir}/tests/test_output/RSV_End_To_End_Test/ASAP_Report_RSV_End_To_End_Test.html")
            assert htmlReport.exists()
            assert snapshot(htmlReport).match("html_report")
            
            }
    }
}