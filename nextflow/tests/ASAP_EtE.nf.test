//conda activate /home/dlemmer/miniconda3/envs/asap
//module load singularity
//nf-test test ./tests/ASAP_EtE.nf.test --profile slurm --update-snapshot
//nf-test test ./tests/ASAP_EtE.nf.test --profile slurm --updateSnapshot --wipeSnapshot
//nf-test test ./tests/ASAP_EtE.nf.test --tag "TB_Amplicon"

nextflow_pipeline {
    name "Test E2E ASAP Pipeline"
    script "main.nf"

    test ("Nextflow Help Test") {
        tag "Help"
        // Goal of this test is to ensure that the help documentation is functional.
        when {
            params {
                help = true
            }
        }
        then {
            assert workflow.success
            def targetFile = new File("tests/test_output/Help/help_docs.txt")
            targetFile.parentFile.mkdirs()
            targetFile.text = workflow.stdout
            
            assert snapshot(workflow.stdout).match("Help")
        }
    }

    test ("RSV E2E Multiple GB Input") {
        tag "RSV_Amplicon"
        // Goal is to test simple ASAP functionality using RSV amplicon reads.
        // Paired end, 2 GB files, no asaptools testing.
        when {
            params {
                read_dir             = "${baseDir}/tests/data/RSV/"
                reference_input      = "${baseDir}/tests/preparejson/RSV*.gb"
                outdir               = "${baseDir}/tests/test_output/RSV_End_To_End_Test"
                aligner              = "bwa"
                proportion           = 0.1
                file_name            = "RSV_End_To_End_Test"
                asaptools_processing = false
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.stdout).match("RSV_End_To_End_Test_Out")
            
            // Check the combined XML
            def xmlReport = path("${baseDir}/tests/test_output/RSV_End_To_End_Test/RSV_End_To_End_Test_analysis.xml")
            assert xmlReport.exists()
            assert snapshot(xmlReport).match("combined_xml")
            
            // Check the combined HTML (Final Output)
            def htmlReport = path("${baseDir}/tests/test_output/RSV_End_To_End_Test/ASAP_Report_RSV_End_To_End_Test.html")
            assert htmlReport.exists()
            assert snapshot(htmlReport).match("html_report")
            
            }
    }
    
    test ("TB Ampseq E2E") {
        tag "TB_Amplicon"
        // Goal is to test simple ASAP functionality using TBamplicon reads.
        when {
            params {
                read_dir             = "${baseDir}/tests/data/TB_Ampseq/"
                reference_input      = "${baseDir}/tests/preparejson/H37Rv_NC0009623.gb"
                outdir               = "${baseDir}/tests/test_output/TB_End_To_End_Test"
                aligner              = "bwa"
                proportion           = 0.0001
                file_name            = "RSV_End_To_End_Test"
                asaptools_processing = true
                primer_file          = "${baseDir}/tests/bedfiles/H37Rv_NC0009623_Primer_File_Ampseq.bed"
                asaptools_positions_of_interest = "${baseDir}/tests/Genes_Of_Interest/H37Rv_Genes_Of_Interst.csv"
                asaptools_min_location_depth = 499 
                mask_primers         = true
                smor_correction      = true
                fastp_extra_args     = '-l 100'
                identity             = 0.97
                combine_output       = false
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.stdout).match("TB_End_To_End_Test_Out")

            }
    }
}